# AI vision service environment template.
# Copy to .env for local development only; never commit secrets.
# Required for the internal API. Generate a long random token and set the same
# value as VISION_API_TOKEN in the container host and AI_SERVICE_TOKEN in Supabase.
VISION_API_TOKEN=replace_with_a_long_random_secret
LLMFAUCET_ENABLED=true
LLMFAUCET_MODEL=auto:smart
AI_PROVIDER_ORDER=gemini,groq,openai,llmfaucet
AI_PROVIDER_TIMEOUT_SECONDS=14
AI_PROVIDER_TOTAL_TIMEOUT_SECONDS=40

# Optional provider credentials. Leave unset for the no-key community fallback.
# Add them only as server-side secrets in your AI service host.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional model-specific endpoint overrides.
# GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# GROQ_CHAT_COMPLETIONS_URL=https://api.groq.com/openai/v1/chat/completions
# LLMFAUCET_CHAT_COMPLETIONS_URL=https://api.llmfaucet.dev/v1/chat/completions
# OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
# Enable generic YOLO only if the optional requirements-yolo.txt dependencies and weights are installed.
ENABLE_GENERIC_YOLO=false
