# CivicPulse AI Vision Service
# Required for all service routes except liveness.
# Generate a long random value and use the same value as AI_SERVICE_TOKEN in Supabase.
VISION_API_TOKEN=

# Optional hosted providers (each requires its own API key; free tier still requires a private key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Provider order is only a preference; each provider must be configured and allowed by policy.
AI_PROVIDER_PRIORITY=gemini,openrouter,openai
AI_PROVIDER_TIMEOUT_SECONDS=35
AI_PROVIDER_CONNECT_TIMEOUT_SECONDS=8

# Privacy-safe defaults: do not send report photos or text to external model vendors until
# the service's privacy notice, consent and provider data terms have been reviewed.
ALLOW_EXTERNAL_IMAGE_AI=false
ALLOW_EXTERNAL_TEXT_AI=false

# OpenRouter free/shared inference is additionally opted out by default. It is hosted
# by a third party and the selected free model warns against personal/confidential data.
ALLOW_OPENROUTER_IMAGE_FALLBACK=false
ALLOW_OPENROUTER_TEXT_FALLBACK=false

# Optional observability settings
OPENROUTER_SITE_URL=https://civicpulse-ai-production.vercel.app
