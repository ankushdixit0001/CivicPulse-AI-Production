# Copy to dataset/data.yaml and update path to this category's dataset root.
# Train one checkpoint per civic category. This example is for pothole only.
# Directory layout:
# dataset/
#   images/{train,val,test}/
#   labels/{train,val,test}/
path: ../civicpulse-pothole-dataset
train: images/train
val: images/val
test: images/test

names:
  0: pothole
